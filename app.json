{
  "expo": {
    "name": "ねんねノート",
    "slug": "nenne-note",
    "version": "1.0.0",
    "scheme": "nennenote",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F4F4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nennenote.app",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.nennenote.app",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F4",
        "foregroundImage": "./assets/android-icon-foreground-v2.png",
        "backgroundImage": "./assets/android-icon-background-v2.png",
        "monochromeImage": "./assets/android-icon-monochrome-v2.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F4",
          "image": "./assets/splash-icon-v2.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#161616",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
